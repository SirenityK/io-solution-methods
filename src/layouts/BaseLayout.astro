---
import "../styles/global.css";

type Props = {
	title: string;
	description?: string;
};

const {
	title: _title,
	description:
		_description = "Métodos de solución de investigación de operaciones con procedimientos detallados paso a paso.",
} = Astro.props;

const _pageTitle = `${_title} | Métodos de solución IO`;

const _lightTheme = "light";
const _darkTheme = "dark";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={_description} />
    <meta name="generator" content={Astro.generator} />
    <title>{_pageTitle}</title>
    <script is:inline>
      const _lightTheme = "light";
      const _darkTheme = "dark";
      
      let theme = _lightTheme;
      try {
        const storedTheme = localStorage.getItem("theme");

        if (storedTheme === _darkTheme || storedTheme === _lightTheme) {
          theme = storedTheme;
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          theme = _darkTheme;
        }
      } catch {
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          theme = _darkTheme;
        }
      }
      document.documentElement.setAttribute("data-theme", theme);
    </script>
    <script>
      const _lightTheme = "light";
      const _darkTheme = "dark";

      document.addEventListener("DOMContentLoaded", () => {
        const currentTheme =
          document.documentElement.getAttribute("data-theme") === _darkTheme
            ? _darkTheme
            : _lightTheme;
        const themeController = document.querySelector(".theme-controller");

        if (!(themeController instanceof HTMLInputElement)) {
          return;
        }

        themeController.checked = currentTheme === _lightTheme;

        themeController.addEventListener("change", () => {
          const selectedTheme = themeController.checked ? _lightTheme : _darkTheme;

          document.documentElement.setAttribute("data-theme", selectedTheme);
          localStorage.setItem("theme", selectedTheme);
        });
      });
    </script>
  </head>
  <body>
    <div class="min-h-screen bg-base-100">
      <header class="bg-base-100 shadow-sm">
        <nav
          class="navbar mx-auto max-w-6xl px-2 sm:px-4"
          aria-label="Navegación principal"
        >
          <div class="navbar-start">
            <a class="btn btn-ghost text-lg" href="/">
              <span class="badge badge-primary badge-lg">IO</span>
              <span>Métodos IO</span>
            </a>
          </div>
          <div class="navbar-center hidden md:flex">
            <ul class="menu menu-horizontal">
              <li><a href="/transporte">Transporte</a></li>
              <li><a href="/simplex">Simplex</a></li>
              <li><a href="/grafico">Gráfico</a></li>
            </ul>
          </div>
          <div class="navbar-end gap-1">
            <label class="swap swap-rotate">
              <input type="checkbox" class="theme-controller" value={_lightTheme} />
              <!-- sun icon -->
              <svg
                class="swap-on"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-sun-dim-icon lucide-sun-dim"
                ><circle cx="12" cy="12" r="4"></circle><path d="M12 4h.01"
                ></path><path d="M20 12h.01"></path><path d="M12 20h.01"
                ></path><path d="M4 12h.01"></path><path d="M17.657 6.343h.01"
                ></path><path d="M17.657 17.657h.01"></path><path
                  d="M6.343 17.657h.01"></path><path d="M6.343 6.343h.01"
                ></path></svg
              >
              <!-- moon icon -->
              <svg
                class="swap-off"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-moon-icon lucide-moon"
                ><path
                  d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
                ></path></svg
              >
            </label>
            <div class="dropdown dropdown-end md:hidden">
              <button
                type="button"
                class="btn btn-ghost btn-square"
                aria-label="Abrir navegación"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-menu"
                >
                  <path d="M4 12h16"></path>
                  <path d="M4 18h16"></path>
                  <path d="M4 6h16"></path>
                </svg>
              </button>
              <ul
                class="menu dropdown-content menu-sm z-10 mt-3 w-52 rounded-box bg-base-100 p-2 shadow"
              >
                <li><a href="/transporte">Transporte</a></li>
                <li><a href="/simplex">Simplex</a></li>
                <li><a href="/grafico">Gráfico</a></li>
              </ul>
            </div>
          </div>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer
        class="footer footer-horizontal footer-center bg-base-200 text-base-content p-6"
      >
        <aside>
          <p>Investigación de operaciones con explicaciones paso a paso.</p>
        </aside>
      </footer>
    </div>
  </body>
</html>
