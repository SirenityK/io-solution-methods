---
// biome-ignore lint/correctness/noUnusedImports: Astro component imports are consumed by markup.
import BaseLayout from "../layouts/BaseLayout.astro";

const _algorithms = [
	{
		number: "01",
		name: "Transporte",
		href: "/transporte",
		summary:
			"Modela oferta y demanda con asignaciones iniciales, costos visibles y optimización para cerrar el menor costo total.",
		details: ["Asignaciones iniciales", "Ciclos y degeneración", "Costo total"],
		status: "Oferta y demanda",
		badgeClass: "badge-primary",
		buttonClass: "btn-primary",
		figureClass: "text-primary",
	},
	{
		number: "02",
		name: "Simplex tabular",
		href: "/simplex",
		summary:
			"Sigue cada tableau con base, columna pivote, razón mínima y valor objetivo hasta llegar al criterio de optimalidad.",
		details: ["Base inicial", "Tablas por iteración", "Valor objetivo"],
		status: "Tableau completo",
		badgeClass: "badge-secondary",
		buttonClass: "btn-secondary",
		figureClass: "text-secondary",
	},
	{
		number: "03",
		name: "Método gráfico",
		href: "/grafico",
		summary:
			"Construye el plano factible para dos variables, muestra restricciones, vértices candidatos y lectura geométrica de Z.",
		details: ["Región factible", "Vértices", "Óptimo geométrico"],
		status: "Plano factible",
		badgeClass: "badge-accent",
		buttonClass: "btn-accent",
		figureClass: "text-accent",
	},
	{
		number: "04",
		name: "No lineal gráfico",
		href: "/no-lineal",
		summary:
			"Extiende la lectura gráfica a restricciones con cuadrados, curvas, tangencias y fronteras estrictas.",
		details: ["Curvas cuadráticas", "Tangencias", "Valores límite"],
		status: "Cuadrático",
		badgeClass: "badge-info",
		buttonClass: "btn-info",
		figureClass: "text-info",
	},
] as const;
---

<BaseLayout
	title="Inicio"
	description="Métodos de solución de investigación de operaciones para clase TecNM, con rutas preparadas para transporte, simplex tabular, método gráfico y programación no lineal."
>
	<section
		class="hero min-h-[calc(100vh-4rem)] bg-base-200 bg-[linear-gradient(to_right,color-mix(in_oklch,var(--color-base-content)_13%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_oklch,var(--color-base-content)_13%,transparent)_1px,transparent_1px)] bg-size-[2rem_2rem]"
	>
		<div class="hero-content w-full max-w-7xl flex-col gap-8 px-4 py-10 lg:flex-row lg:items-stretch lg:py-14">
			<div class="card card-border w-full bg-base-100 shadow-[10px_10px_0_0_var(--color-neutral)] lg:min-h-136 lg:flex-1">
				<div class="card-body justify-between gap-8 p-6 md:p-8">
					<div class="space-y-6">
						<div class="flex flex-wrap items-center gap-3">
							<span class="badge badge-primary badge-lg badge-outline">TecNM</span>
							<span class="badge badge-primary badge-lg">Investigación de operaciones</span>
						</div>

						<div class="space-y-5">
							<h1 class="max-w-4xl text-4xl font-black leading-tight md:text-6xl lg:text-7xl">
								Investigación de operaciones, sin saltarse pasos.
							</h1>
							<p class="max-w-2xl text-lg leading-8 text-base-content/75">
								Una guía interactiva para seguir cada tabla, pivote, asignación y
								vértice con el mismo ritmo de una explicación en pizarrón.
							</p>
						</div>

						<div class="w-full m:w-auto">
							<a class="btn btn-primary" href="#algoritmos">Ver métodos</a>
							<a class="btn btn-outline" href="/grafico">Abrir método gráfico</a>
						</div>
					</div>

					<div class="stats stats-vertical bg-base-200 shadow-[6px_6px_0_0_var(--color-neutral)] md:stats-horizontal">
						<div class="stat">
							<div class="stat-value text-primary">04</div>
							<div class="stat-title">métodos disponibles</div>
						</div>
						<div class="stat">
							<div class="stat-value text-secondary">Paso</div>
							<div class="stat-title">decisiones explicadas</div>
						</div>
						<div class="stat">
							<div class="stat-value text-accent">Edita</div>
							<div class="stat-title">ejemplos ajustables</div>
						</div>
					</div>
				</div>
			</div>

			<div class="grid w-full gap-4 lg:w-md">
				<div class="mockup-window bg-base-300 shadow-[8px_8px_0_0_var(--color-neutral)]">
					<div class="grid gap-4 bg-base-100 p-4">
						<div class="card bg-warning/20">
							<div class="card-body gap-3 p-4">
								<div class="flex items-center justify-between gap-3">
									<span class="badge badge-warning badge-outline">Transporte</span>
									<span class="font-mono text-xs font-bold">min Z</span>
								</div>
								<div class="overflow-x-auto rounded-box shadow-md bg-base-100">
									<table class="table table-xs">
										<tbody class="font-mono">
											<tr>
												<th>O/D</th>
												<td>D1</td>
												<td>D2</td>
												<td>D3</td>
												<td>Of.</td>
											</tr>
											<tr>
												<th>O1</th>
												<td>8</td>
												<td class="bg-primary text-primary-content">6</td>
												<td>10</td>
												<td>100</td>
											</tr>
											<tr>
												<th>O2</th>
												<td>9</td>
												<td>7</td>
												<td class="bg-accent text-accent-content">4</td>
												<td>120</td>
											</tr>
										</tbody>
									</table>
								</div>
							</div>
						</div>

						<div class="card bg-info/15">
							<div class="card-body gap-3 p-4">
								<div class="flex items-center justify-between gap-3">
									<span class="badge badge-info badge-outline">Simplex</span>
									<span class="font-mono text-xs font-bold">pivote</span>
								</div>
								<div class="overflow-x-auto rounded-box bg-base-100">
									<table class="table table-xs">
										<tbody class="font-mono">
											<tr>
												<th>Base</th>
												<td>x</td>
												<td>y</td>
												<td>R</td>
											</tr>
											<tr>
												<th>s1</th>
												<td>2</td>
												<td class="bg-secondary text-secondary-content">1</td>
												<td>10</td>
											</tr>
											<tr>
												<th>Z</th>
												<td>-30</td>
												<td>-40</td>
												<td>0</td>
											</tr>
										</tbody>
									</table>
								</div>
							</div>
						</div>

						<div class="card bg-accent/15">
							<div class="card-body gap-3 p-4">
								<div class="flex items-center justify-between gap-3">
									<span class="badge badge-accent badge-outline">Gráfico</span>
									<span class="font-mono text-xs font-bold">x1, x2</span>
								</div>
								<div class="h-36 overflow-hidden rounded-box bg-base-100 p-3">
									<svg
										viewBox="0 0 280 136"
										role="img"
										aria-label="Plano cartesiano con región factible"
										class="h-full w-full"
									>
										<path
											d="M24 118H260M36 126V14"
											class="stroke-neutral"
											stroke-width="3"
											fill="none"
										/>
										<path
											d="M52 96L124 38L226 88L184 118H64Z"
											class="fill-accent/30 stroke-accent"
											stroke-width="4"
										/>
										<path
											d="M36 98L246 32M66 118L218 28M36 66L248 112"
											class="stroke-primary"
											stroke-width="3"
											fill="none"
											stroke-linecap="round"
										/>
										<circle cx="124" cy="38" r="6" class="fill-secondary" />
										<circle cx="226" cy="88" r="6" class="fill-secondary" />
										<text x="232" y="84" class="fill-base-content text-sm font-black">
											Z
										</text>
									</svg>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="alert alert-info alert-outline bg-base-100">
					<span class="font-semibold">
						Avanza, compara y revisa por qué se eligió cada celda, pivote o
						vértice.
					</span>
				</div>
			</div>
		</div>
	</section>

	<section class="border-b-2 border-neutral bg-base-200">
		<div class="mx-auto max-w-7xl px-4 py-10 md:py-12">
			<div class="grid gap-5 lg:grid-cols-3">
				<article class="card bg-base-100 shadow-[6px_6px_0_0_var(--color-neutral)]">
					<div class="card-body">
						<span class="badge badge-primary badge-outline">1</span>
						<h2 class="card-title">Decisión actual</h2>
						<p class="text-base-content/75">
							La página marca el costo, pivote, penalización o vértice que importa
							en ese momento.
						</p>
					</div>
				</article>

				<article class="card bg-base-100 shadow-[6px_6px_0_0_var(--color-neutral)]">
					<div class="card-body">
						<span class="badge badge-secondary badge-outline">2</span>
						<h2 class="card-title">Tabla en movimiento</h2>
						<p class="text-base-content/75">
							Las cantidades, bases y regiones cambian conforme avanzas, sin perder
							el estado anterior.
						</p>
					</div>
				</article>

				<article class="card bg-base-100 shadow-[6px_6px_0_0_var(--color-neutral)]">
					<div class="card-body">
						<span class="badge badge-accent badge-outline">3</span>
						<h2 class="card-title">Cierre verificable</h2>
						<p class="text-base-content/75">
							Cada método llega al resultado final con costo, valor objetivo o punto
							óptimo claramente identificado.
						</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section id="algoritmos" class="bg-base-100">
		<div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
			<div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
				<div>
					<span class="badge badge-primary badge-lg">Fichas de método</span>
					<h2 class="mt-4 text-3xl font-black md:text-5xl">Algoritmos implementados</h2>
				</div>
				<p class="max-w-2xl text-base-content/70">
					Cada método abre un ejercicio editable con explicación paso a paso,
					resaltado visual y cierre del resultado para estudiar o comprobar el
					procedimiento.
				</p>
			</div>

			<div class="grid gap-5 lg:grid-cols-3">
				{
					_algorithms.map((algorithm) => (
						<article class="card card-border border border-neutral bg-base-100 shadow-[7px_7px_0_0_var(--color-neutral)]">
							<div class="card-body gap-5">
								<div class="flex items-start justify-between gap-4">
									<div>
										<div class={`badge badge-outline ${algorithm.badgeClass}`}>
											{algorithm.status}
										</div>
										<h3 class="card-title mt-4 text-2xl">{algorithm.name}</h3>
									</div>
									<div class={`font-mono text-5xl font-black ${algorithm.figureClass}`}>
										{algorithm.number}
									</div>
								</div>

								<p class="text-base-content/75">{algorithm.summary}</p>

								<div class="flex flex-wrap gap-2">
									{algorithm.details.map((detail) => (
										<span class="badge badge-info badge-soft">{detail}</span>
									))}
								</div>

								<div class="divider my-0"></div>

								<div class="card-actions items-center justify-between gap-3">
									<span class="badge badge-outline">Paso a paso</span>
									<a
										class={`btn ${algorithm.buttonClass}`}
										href={algorithm.href}
										aria-label={`Abrir ${algorithm.name}`}
									>
										Abrir método
										<span aria-hidden="true">→</span>
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
